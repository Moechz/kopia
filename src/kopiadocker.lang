# ===========================================================================
# Multilingual file for the TOS 7 Docker application "kopiadocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Kopia"
auth         = "kopia"
version      = "@@VERSION@@"
descript     = "Kopia is a fast, encrypted, deduplicated backup tool with a web UI: snapshot folders on the NAS into a repository on local disk, S3, Backblaze B2, WebDAV, SFTP, Google Cloud or another Kopia server; schedule snapshots, browse versions, restore files and apply retention policies. Data is encrypted on the NAS before it leaves. The UI is protected by HTTP Basic auth; repository and configuration stay in the application data folder."
release_note = "2. Rectified per review comments (C2-C8, C10, T1, F5, F10). Public landing page so the App Center can open the app, while the UI itself stays behind HTTP Basic auth; the UI password is no longer printed to the log; PRIVACY.md, NOTICE.md and README.md completed; third-party endpoint table; the repository password is persisted (mode 600) so snapshots survive a restart; update checks and telemetry are off. The pinned image is the newest upstream build."
important    = "Requires DockerEngine (installed automatically if missing). Open the app, click 'Open the Kopia web interface' and log in as user `kopia`; the random password is generated on first start and stored in DockerAppData/kopiadocker/config/.server-password (mode 600). Create the repository in the UI - a folder under /data is simplest, S3/B2/WebDAV/SFTP also work - and keep its password: without it snapshots cannot be restored. Plain HTTP; put a TLS reverse proxy in front before exposing it to the internet."

[zh-cn]
name         = "Kopia"
auth         = "kopia"
version      = "@@VERSION@@"
descript     = "Kopia 是一款快速、加密、去重的备份工具，自带网页界面：把 NAS 上的目录做成快照，存到本地磁盘、S3、Backblaze B2、WebDAV、SFTP、Google Cloud 或另一台 Kopia 服务器上的仓库；支持定时快照、浏览历史版本、还原文件与保留策略。数据在离开 NAS 之前就已加密。界面受 HTTP Basic 认证保护；仓库与配置都保存在应用数据目录。"
release_note = "2. 按审核意见整改（C2-C8、C10、T1、F5、F10）。新增公开引导页，使应用中心能正常打开，而界面本身仍受 HTTP Basic 认证保护；界面密码不再打印到日志；补齐 PRIVACY.md、NOTICE.md 与 README.md；新增第三方端点表；仓库密码持久化（权限 600），重启后快照任务不中断；关闭更新检查与遥测。镜像仍为上游最新构建。"
important    = "需要 DockerEngine（缺失时应用中心会自动安装）。打开应用后，在引导页点「Open the Kopia web interface」，用用户名 `kopia` 登录；随机密码在首次启动时生成，保存在 DockerAppData/kopiadocker/config/.server-password（权限 600）。请在界面里创建仓库（放在 /data 下最简单，也可用 S3/B2/WebDAV/SFTP），并记住仓库密码——没有它无法还原快照。界面为纯 HTTP，暴露到公网前请配置带 TLS 的反向代理。"

[zh-hk]
name         = "Kopia"
auth         = "kopia"
version      = "@@VERSION@@"
descript     = "Kopia 是一款快速、加密、去重的備份工具，自帶網頁介面：把 NAS 上的目錄做成快照，存到本機磁碟、S3、Backblaze B2、WebDAV、SFTP、Google Cloud 或另一台 Kopia 伺服器上的倉庫；支援定時快照、瀏覽歷史版本、還原檔案與保留策略。資料在離開 NAS 之前就已加密。介面受 HTTP Basic 認證保護；倉庫與設定都保存在應用資料目錄。"
release_note = "2. 按審核意見整改（C2-C8、C10、T1、F5、F10）。新增公開引導頁，使應用中心能正常開啟，而介面本身仍受 HTTP Basic 認證保護；介面密碼不再列印到日誌；補齊 PRIVACY.md、NOTICE.md 與 README.md；新增第三方端點表；倉庫密碼持久化（權限 600），重啟後快照任務不中斷；關閉更新檢查與遙測。映像仍為上游最新建置。"
important    = "需要 DockerEngine（缺少時應用中心會自動安裝）。開啟應用後，在引導頁點「Open the Kopia web interface」，用使用者名稱 `kopia` 登入；隨機密碼在首次啟動時產生，保存在 DockerAppData/kopiadocker/config/.server-password（權限 600）。請在介面裡建立倉庫（放在 /data 下最簡單，也可用 S3/B2/WebDAV/SFTP），並記住倉庫密碼——沒有它無法還原快照。介面為純 HTTP，公開到互聯網前請配置帶 TLS 的反向代理。"

